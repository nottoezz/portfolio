---
import { getCollection, render } from "astro:content";
import { Image, getImage } from "astro:assets";
import Base from "../../layouts/Base.astro";
import Status from "../../components/Status.astro";
import Contact from "../../components/Contact.astro";

export async function getStaticPaths() {
  const work = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
  return work.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, index: i, total: work.length, next: work[(i + 1) % work.length] },
  }));
}

const { entry, index, total, next } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const pad = (n: number) => String(n).padStart(2, "0");
const host = data.url ? new URL(data.url).hostname.replace(/^www\./, "") : null;
const og = data.cover ? (await getImage({ src: data.cover, width: 1200, height: 630, fit: "cover", position: "top", format: "png" })).src : undefined;
---

<Base title={`${data.title}: ${data.kind} · Liam Birch`} description={data.summary} image={og}>
  <article>
    <!-- ─────────────── Header ─────────────── -->
    <header class="wrap pb-12 pt-5 md:pb-16 md:pt-8">
      <p class="label flex items-center justify-between gap-4 border-b border-rule pb-3 text-ink-3">
        <a href="/#work" class="link-underline py-1 hover:text-ink"><span aria-hidden="true">←</span> Index</a>
        <span>Case {pad(index + 1)} / {pad(total)}</span>
      </p>

      <div class="mt-10 md:mt-16">
        <p class="label text-accent" data-reveal>{data.kind}</p>
        <h1 class="display mt-4 text-[clamp(2.6rem,10.5vw,8.5rem)]" data-reveal style="--d: .06s">{data.title}</h1>
        <p class="mt-5 max-w-[26ch] text-[clamp(1.5rem,4.8vw,2.75rem)] italic leading-[1.1] text-ink-2" data-reveal style="--d: .12s">
          {data.tagline}
        </p>
      </div>

      <dl class="mt-12 grid grid-cols-2 border-t border-ink md:mt-16 md:grid-cols-4" data-reveal style="--d: .18s">
        <div class="col-span-2 border-b border-rule py-4 pr-4 md:col-span-1 md:border-b-0 md:border-r">
          <dt class="label text-ink-3">Role</dt>
          <dd class="mt-2 leading-snug">{data.role}</dd>
        </div>
        <div class="col-span-2 border-b border-rule py-4 md:col-span-1 md:border-b-0 md:border-r md:px-4">
          <dt class="label text-ink-3">{data.context.label}</dt>
          <dd class="mt-2 leading-snug">{data.context.value}</dd>
        </div>
        <div class="border-r border-rule py-4 pr-4 md:px-4">
          <dt class="label text-ink-3">Status</dt>
          <dd class="mt-2"><Status status={data.status} /></dd>
        </div>
        <div class="py-4 pl-4">
          <dt class="label text-ink-3">{host ? "Visit" : "Link"}</dt>
          <dd class="mt-2">
            {
              host ? (
                <span class="flex flex-col items-start gap-1">
                  <a href={data.url} target="_blank" rel="noopener noreferrer" class="link-underline break-all hover:text-accent">
                    {host} <span aria-hidden="true">↗</span>
                  </a>
                  {data.appStore && (
                    <a href={data.appStore} target="_blank" rel="noopener noreferrer" class="link-underline hover:text-accent">
                      App Store <span aria-hidden="true">↗</span>
                    </a>
                  )}
                </span>
              ) : (
                <span class="text-ink-3">{data.status === "Retired" ? "Offline" : "On request"}</span>
              )
            }
          </dd>
        </div>
      </dl>
    </header>

    <!-- ─────────────── Plate ─────────────── -->
    <figure class="wrap" data-reveal>
      {
        data.cover ? (
          <div class="relative">
            <div class="overflow-hidden border border-ink bg-paper-2">
              <div class="flex items-center gap-1.5 border-b border-ink px-3 py-2" aria-hidden="true">
                <span class="size-2 rounded-full border border-ink" />
                <span class="size-2 rounded-full border border-ink" />
                <span class="size-2 rounded-full border border-ink" />
                <span class="label ml-3 truncate text-[0.65rem] text-ink-3">{host ?? data.title.toLowerCase().replace(/\s+/g, "-")}</span>
              </div>
              <Image
                src={data.cover}
                alt={data.coverAlt ?? ""}
                widths={[640, 960, 1440, 2000]}
                sizes="(min-width: 88rem) 83rem, calc(100vw - 2rem)"
                class="block w-full"
                loading="eager"
                fetchpriority="high"
              />
            </div>
            {data.mobile && (
              <div class="absolute -bottom-10 right-4 hidden w-[17%] min-w-36 max-w-56 overflow-hidden rounded-[1.4rem] border-[3px] border-ink bg-paper shadow-[0_30px_60px_-20px_rgb(0_0_0/0.4)] sm:block md:right-10">
                <Image src={data.mobile} alt={data.mobileAlt ?? ""} widths={[240, 480]} sizes="14rem" class="block w-full" />
              </div>
            )}
          </div>
        ) : (
          <div class="relative grid aspect-[16/10] place-items-center overflow-hidden bg-ink p-6 text-on-ink md:aspect-[21/9]">
            <span class="label absolute left-5 top-5 opacity-60">&gt; {data.title.toLowerCase().replace(/\s+/g, "_")}.exe</span>
            <span class="label absolute bottom-5 right-5 opacity-60">Case {pad(index + 1)}</span>
            <p class="display text-center text-[clamp(2.5rem,9vw,7.5rem)]">
              {data.tagline}
              <span class="cursor-blink text-accent">_</span>
            </p>
          </div>
        )
      }
      <figcaption class="label mt-4 text-ink-3 sm:mt-14">
        Fig. {pad(index + 1)}: {data.cover ? (data.url ? "Live site, captured on desktop and mobile" : "Product screenshot") : "Title card"}
      </figcaption>
    </figure>

    <!-- ─────────────── Body ─────────────── -->
    <div class="wrap mt-16 grid gap-14 pb-20 md:mt-24 md:pb-32 lg:grid-cols-12">
      <aside class="lg:col-span-4">
        <div class="lg:sticky lg:top-24">
          <p class="text-2xl leading-snug" data-reveal>{data.summary}</p>
          <h2 class="label mt-10 border-b border-rule pb-2 text-ink-3">Stack</h2>
          <ul class="mt-3 flex flex-wrap gap-2">
            {data.stack.map((s) => <li class="label border border-rule px-2.5 py-1.5 text-ink-2">{s}</li>)}
          </ul>
        </div>
      </aside>

      <div class="lg:col-span-7 lg:col-start-6">
        <div class="prose-case" data-reveal>
          <Content />
        </div>

        {
          data.features.length > 0 && (
            <section class="mt-12" data-reveal>
              <h2 class="label border-t border-rule pt-4 text-ink-3">Key features</h2>
              <ul class="mt-5 grid gap-x-8 sm:grid-cols-2">
                {data.features.map((f, i) => (
                  <li class="flex gap-4 border-b border-rule py-3 text-lg">
                    <span class="label pt-1.5 text-ink-3">{pad(i + 1)}</span>
                    {f}
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <section class="mt-14 bg-paper-2 p-6 md:p-10" data-reveal>
          <h2 class="label text-accent">Outcome</h2>
          <p class="mt-4 text-[clamp(1.35rem,3vw,1.9rem)] leading-snug">{data.outcome}</p>
        </section>
      </div>
    </div>

    <!-- ─────────────── Next ─────────────── -->
    <nav class="border-t border-ink" aria-label="Next case study">
      <a href={`/work/${next.id}`} class="wrap group block py-12 md:py-20">
        <span class="label flex justify-between text-ink-3">
          <span>Next case</span>
          <span>{next.data.kind}</span>
        </span>
        <span class="display mt-5 flex items-end justify-between gap-6 text-[clamp(2.25rem,9vw,7.5rem)] transition-colors group-hover:text-accent">
          {next.data.title}
          <span class="shrink-0 transition-transform duration-300 group-hover:translate-x-2" aria-hidden="true">→</span>
        </span>
      </a>
    </nav>
  </article>

  <Contact />
</Base>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .cursor-blink {
      animation: blink 1.1s steps(1) infinite;
    }
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
</style>
