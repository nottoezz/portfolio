---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Contact from "../../components/Contact.astro";

export async function getStaticPaths() {
  const lab = (await getCollection("lab")).sort((a, b) => a.data.order - b.data.order);
  return lab.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, index: i } }));
}

const { entry, index } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const num = String(index + 1).padStart(3, "0");
const done = data.roadmap.filter((r) => r.done).length;
---

<Base title={`${data.title}: ${data.kind} · Lab · Liam Birch`} description={data.summary} theme="night">
  <article>
    <header class="wrap pb-12 pt-5 md:pb-16 md:pt-8">
      <p class="label flex items-center justify-between gap-4 border-b border-rule pb-3 text-ink-3">
        <a href="/#lab" class="link-underline py-1 hover:text-ink"><span aria-hidden="true">←</span> Lab</a>
        <span>Experiment {num}</span>
      </p>

      <div class="mt-10 md:mt-16">
        <p class="label flex flex-wrap items-center gap-3 text-phosphor" data-reveal>
          <span class="border border-phosphor/60 px-2 py-1">{data.status}</span>
          <span>{data.kind}</span>
        </p>
        <h1 class="display mt-5 text-[clamp(2.6rem,11vw,9rem)]" data-reveal style="--d: .06s">{data.title}</h1>
        <p class="mt-5 max-w-[30ch] text-[clamp(1.4rem,4.4vw,2.5rem)] italic leading-[1.15] text-ink-2" data-reveal style="--d: .12s">
          {data.summary}
        </p>
      </div>

      {
        data.play && (
          <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center md:mt-14" data-reveal style="--d: .18s">
            <a
              href={data.play}
              target="_blank"
              rel="noopener noreferrer"
              class="label inline-flex items-center justify-between gap-8 bg-phosphor px-6 py-5 text-sm text-[#0f0e0c] transition-colors hover:bg-ink sm:justify-start"
            >
              Play it <span aria-hidden="true">↗</span>
            </a>
            {data.source && (
              <a
                href={data.source}
                target="_blank"
                rel="noopener noreferrer"
                class="label inline-flex items-center justify-between gap-8 border border-rule px-6 py-5 text-sm transition-colors hover:border-ink sm:justify-start"
              >
                Source <span aria-hidden="true">↗</span>
              </a>
            )}
            {data.playNote && <p class="label text-ink-3 sm:ml-3">{data.playNote}</p>}
          </div>
        )
      }
    </header>

    <!-- Title card -->
    <figure class="wrap" data-reveal>
      <div class="crt relative grid aspect-[4/3] place-items-center overflow-hidden border border-rule bg-[#080706] p-6 sm:aspect-[16/9] md:aspect-[21/9]">
        <span class="label absolute left-5 top-5 text-phosphor/70">&gt; {data.file}</span>
        <span class="label absolute right-5 top-5 text-ink-3">{data.year}</span>
        <span class="label absolute bottom-5 left-5 text-ink-3">Exp. {num}</span>
        <p class="display text-center text-[clamp(2.25rem,8.5vw,7rem)] text-phosphor">
          {data.tagline}<span class="lab-cursor">_</span>
        </p>
      </div>
    </figure>

    <div class="wrap mt-16 grid gap-14 pb-20 md:mt-24 md:pb-32 lg:grid-cols-12">
      <aside class="lg:col-span-4">
        <div class="lg:sticky lg:top-24">
          <h2 class="label border-b border-rule pb-2 text-ink-3">Stack</h2>
          <ul class="mt-3 flex flex-wrap gap-2">
            {data.stack.map((s) => <li class="label border border-rule px-2.5 py-1.5 text-ink-2">{s}</li>)}
          </ul>

          {
            data.roadmap.length > 0 && (
              <>
                <h2 class="label mt-10 flex justify-between border-b border-rule pb-2 text-ink-3">
                  <span>Roadmap</span>
                  <span>
                    {done}/{data.roadmap.length}
                  </span>
                </h2>
                <ul class="mt-3 font-mono text-[0.95rem] leading-relaxed">
                  {data.roadmap.map((r) => (
                    <li class:list={["flex gap-3 py-1", r.done ? "text-ink-3" : "text-ink"]}>
                      <span class={r.done ? "text-phosphor/70" : "text-phosphor"} aria-hidden="true">
                        {r.done ? "[x]" : "[ ]"}
                      </span>
                      <span>
                        {r.item}
                        <span class="sr-only">{r.done ? " (done)" : " (to do)"}</span>
                      </span>
                    </li>
                  ))}
                </ul>
              </>
            )
          }
        </div>
      </aside>

      <div class="prose-case lg:col-span-7 lg:col-start-6" data-reveal>
        <Content />
      </div>
    </div>
  </article>

  <Contact />
</Base>

<style>
  .crt::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(to bottom, rgb(255 255 255 / 0.035) 0 1px, transparent 1px 3px);
  }
  .crt p {
    text-shadow: 0 0 24px rgb(255 190 64 / 0.35);
  }
  @media (prefers-reduced-motion: no-preference) {
    .lab-cursor {
      animation: lab-blink 1.1s steps(1) infinite;
    }
  }
  @keyframes lab-blink {
    50% {
      opacity: 0;
    }
  }
</style>
