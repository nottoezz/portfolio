---
import Eye from "./Eye.astro";
const isHome = Astro.url.pathname === "/";
const base = isHome ? "" : "/";
const nav = [
  { href: `${base}#work`, label: "Work" },
  { href: `${base}#lab`, label: "Lab" },
  { href: `${base}#about`, label: "About" },
  { href: `${base}#contact`, label: "Contact" },
];
---

<header class="sticky top-0 z-50 border-b border-rule bg-paper/85 backdrop-blur-md">
  <div class="wrap flex h-14 items-center justify-between gap-4">
    <a href="/" class="group flex items-center gap-2.5" aria-label="Liam Birch, home">
      <Eye class="h-6 w-9" />
      <span class="display whitespace-nowrap text-[0.85rem] tracking-[0.02em] transition-colors group-hover:text-accent sm:text-[0.95rem]">Liam Birch</span>
    </a>
    <nav aria-label="Primary">
      <ul class="flex items-center gap-3 sm:gap-7">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="label link-underline py-2 tracking-[0.06em] text-ink-2 hover:text-ink sm:tracking-[0.16em]">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
