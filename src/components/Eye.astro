---
/**
 * The watching eye: the site's signature mark.
 * Follows the pointer on desktop, glances around on touch, blinks now and then.
 * `ring` draws the circle around it (used large in the hero).
 */
interface Props {
  class?: string;
  ring?: boolean;
  label?: string;
}
const { class: className = "", ring = false, label } = Astro.props;
---

<div
  class:list={["eye relative", ring && "eye--ring", className]}
  data-eye
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
>
  {
    ring && (
      <svg class="eye__ring absolute inset-0 h-full w-full" viewBox="0 0 200 200" fill="none">
        <circle cx="100" cy="100" r="97" stroke="currentColor" stroke-width="1.25" pathLength="1" />
      </svg>
    )
  }
  <div class:list={[ring ? "absolute inset-[14%] grid place-items-center" : "h-full w-full"]}>
  <svg
    class="eye__svg h-full w-full"
    viewBox="0 0 120 80"
    fill="none"
  >
    <g class="eye__lid" data-lid>
      <path
        d="M60 16C32 16 15 32 9 40c-1 1-1 3 0 4 6 8 23 24 51 24s45-16 51-24c1-1 1-3 0-4-6-8-23-24-51-24Z"
        fill="var(--paper)"
        stroke="currentColor"
        stroke-width="2"
        stroke-linejoin="round"></path>
      <g class="eye__pupil" data-pupil>
        <circle cx="60" cy="42" r="13" stroke="currentColor" stroke-width="1.25"></circle>
        <circle cx="60" cy="42" r="7.5" fill="currentColor"></circle>
        <circle cx="57.5" cy="39.5" r="2" fill="var(--paper)"></circle>
      </g>
    </g>
  </svg>
  </div>
</div>

<style>
  .eye__lid {
    transform-box: fill-box;
    transform-origin: 50% 50%;
    transition: transform 0.12s ease-in-out;
  }
  .eye.is-blinking .eye__lid {
    transform: scaleY(0.08);
  }
  .eye__pupil {
    will-change: transform;
  }
  .eye__ring circle {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transform: rotate(-90deg);
    transform-origin: center;
    animation: eye-ring 1.8s cubic-bezier(0.65, 0, 0.35, 1) 0.3s forwards;
  }
  @keyframes eye-ring {
    to {
      stroke-dashoffset: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .eye__ring circle {
      stroke-dashoffset: 0;
      animation: none;
    }
  }
</style>

<script>
  const eyes = [...document.querySelectorAll<HTMLElement>("[data-eye]")];
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
  const MAX = 9; // px in SVG units

  type State = { el: HTMLElement; pupil: SVGGElement; x: number; y: number; tx: number; ty: number; visible: boolean };
  const states: State[] = eyes.map((el) => ({
    el,
    pupil: el.querySelector("[data-pupil]") as SVGGElement,
    x: 0,
    y: 0,
    tx: 0,
    ty: 0,
    visible: true,
  }));

  if (!reduce && states.length) {
    // Only animate eyes that are on screen
    const io = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        const s = states.find((st) => st.el === entry.target);
        if (s) s.visible = entry.isIntersecting;
      }
    });
    states.forEach((s) => io.observe(s.el));

    if (finePointer) {
      window.addEventListener(
        "pointermove",
        (e) => {
          for (const s of states) {
            if (!s.visible) continue;
            const r = s.el.getBoundingClientRect();
            const dx = e.clientX - (r.left + r.width / 2);
            const dy = e.clientY - (r.top + r.height / 2);
            const dist = Math.hypot(dx, dy) || 1;
            const k = Math.min(dist / 220, 1); // ease toward the edge as cursor moves away
            s.tx = (dx / dist) * MAX * k;
            s.ty = (dy / dist) * MAX * 0.7 * k;
          }
          kick();
        },
        { passive: true },
      );
    } else {
      // Touch: glance somewhere new every couple of seconds
      const glance = () => {
        const a = Math.random() * Math.PI * 2;
        const m = Math.random() < 0.3 ? 0 : MAX * (0.5 + Math.random() * 0.5);
        for (const s of states) {
          s.tx = Math.cos(a) * m;
          s.ty = Math.sin(a) * m * 0.7;
        }
        kick();
        setTimeout(glance, 1600 + Math.random() * 2400);
      };
      setTimeout(glance, 1200);
    }

    // rAF loop that sleeps once the pupils have settled
    let raf = 0;
    const tick = () => {
      let moving = false;
      for (const s of states) {
        s.x += (s.tx - s.x) * 0.12;
        s.y += (s.ty - s.y) * 0.12;
        if (Math.abs(s.tx - s.x) > 0.02 || Math.abs(s.ty - s.y) > 0.02) moving = true;
        s.pupil.style.transform = `translate(${s.x.toFixed(2)}px, ${s.y.toFixed(2)}px)`;
      }
      raf = moving ? requestAnimationFrame(tick) : 0;
    };
    const kick = () => {
      if (!raf) raf = requestAnimationFrame(tick);
    };

    // Blink
    const blink = () => {
      states.forEach((s) => s.visible && s.el.classList.add("is-blinking"));
      setTimeout(() => states.forEach((s) => s.el.classList.remove("is-blinking")), 140);
      setTimeout(blink, 2800 + Math.random() * 4200);
    };
    setTimeout(blink, 2200);
  }
</script>
